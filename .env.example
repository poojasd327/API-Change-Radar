# Server configuration
PORT=5001
NODE_ENV=development

# Optional: Mock API Base URL override (defaults to http://127.0.0.1:PORT/mock-api/products)
# MOCK_API_BASE_URL=http://127.0.0.1:5001/mock-api/products

# MongoDB connection string
# MONGODB_URI=mongodb://localhost:27017/apichange_radar

# Optional: Automatic monitoring check schedule (defaults to every 5 minutes: */5 * * * *)
# CHECK_CRON_SCHEDULE=*/5 * * * *

# Optional: Temporary testing scenario for scheduled checks (e.g. wrong-price-type, missing-price, server-error, slow)
# Leave unset or empty for normal monitoring
# SCHEDULER_TEST_SCENARIO=wrong-price-type


